# Blockchain (Secret - server-side only)
PRIVATE_KEY=your_private_key
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETHERSCAN_API_KEY=your_etherscan_api_key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Privy server authentication (server-side only; never use NEXT_PUBLIC_ here)
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\\nYOUR_PRIVY_VERIFICATION_KEY\\n-----END PUBLIC KEY-----"
